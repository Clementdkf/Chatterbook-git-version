    m_Metadata:
      m_Items: []
  - m_Id: 73254355042304
    m_Localized: Ignore them
    m_Metadata:
      m_Items: []
  - m_Id: 73334483025920
    m_Localized: apologized to them
    m_Metadata:
      m_Items: []
  - m_Id: 73429022638080
    m_Localized: You are correct!
    m_Metadata:
      m_Items: []
  - m_Id: 73572652384256
    m_Localized: "In the end, Bos, Orange, Isbert and Jimmie  become friends again
      as before.\r\nThey enjoyed various fruits and watched the sunset together.
      \r\n"
