    m_Metadata:
      m_Items: []
  - m_Id: 2471530379313152
    m_Localized: http://appapi.dctit.hk:1575/
    m_Metadata:
      m_Items: []
  - m_Id: 8314377384984576
    m_Localized: "\u5728\u4E3B\u9078\u55AE\u4E2D, \u60A8\u53EF\u4EE5\u5F9E\u76EE\u9304\u4E2D\u9078\u64C7\u8981\u95B1\u8B80\u7684\u5716\u66F8\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8314475393286144
    m_Localized: "\u9078\u55AE\u5C0E\u822A"
    m_Metadata:
      m_Items: []
  - m_Id: 8314520716935168
    m_Localized: "\u5716\u66F8\u5C0E\u822A"
    m_Metadata:
      m_Items: []
  - m_Id: 8314559375835136
    m_Localized: "\u5C0F\u904A\u6232\u5C0E\u822A"
    m_Metadata:
      m_Items: []
  - m_Id: 8315560216461312
    m_Localized: "\u7576\u4F60\u5728\u96FB\u5B50\u66F8\u9801\u9762\u6642, \u4F60\u53EF\u4EE5\u4F7F\u7528\u5DE6\u53F3\u6309\u9215\u700F\u89BD\u5716\u66F8\u3002\n\n\u66F8\u7C4D\u5305\u542B\u4E92\u52D5\u5143\u7D20,
      \u5305\u62EC\u591A\u9805\u9078\u64C7\u984C, \u4EE5\u53CA\u5BB6\u9577\u548C\u5B50\u5973\u4E92\u52D5\u7684\u60C5\u7BC0\u3002\n\u60A8\u4E5F\u53EF\u4EE5\u4F7F\u7528\u66F8\u7C64\u6309\u9215\u5C07\u9801\u9762\u52A0\u5165\u66F8\u7C64\uFF0C\u9019\u6A23\u7576\u60A8\u7A0D\u5F8C\u8FD4\u56DE\u672C\u66F8\u6642\uFF0C\u5C31\u53EF\u4EE5\u5F9E\u60A8\u52A0\u5165\u66F8\u7C64\u7684\u9801\u9762\u958B\u59CB\u95B1\u8B80\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8317578968530944
    m_Localized: "\u5728\u914D\u5C0D\u5C0F\u904A\u6232\u4E2D\uFF0C\u4F60\u9700\u8981\u8B58\u5225\u4E00\u500B\u7279\u5FB5\u4E26\u5C07\u5176\u8207\u76F8\u61C9\u7684\u6309\u9215\u914D\u5C0D\u3002\r\n\u4F8B\u5982\uFF0C\u5982\u679C\u4F60\u6309\u4E0B\u4E00\u500B\u5BEB\u8457\u300C\u85CD\u8272\u300D\u7684\u6309\u9215\uFF0C\u7136\u5F8C\u4F60\u9700\u8981\u627E\u5230\u4E26\u6309\u4E0B\u984F\u8272\u70BA\u85CD\u8272\u7684\u6309\u9215\u3002\r\n\u5982\u679C\u914D\u5C0D\u932F\u8AA4\uFF0C\u6309\u9215\u548C\u914D\u5C0D\u9805\u6703\u986F\u793A\u7D05\u8272\u908A\u6846\uFF0C\u60A8\u53EF\u4EE5\u91CD\u65B0\u9078\u64C7\u4E26\u518D\u6B21\u914D\u5C0D\u3002\r\n\u5982\u679C\u914D\u5C0D\u6B63\u78BA\uFF0C\u6309\u9215\u548C\u914D\u5C0D\u9805\u6703\u986F\u793A\u7DA0\u8272\u908A\u6846\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 8317746300289024
    m_Localized: "\u5728\u9019\u500B\u5C0F\u904A\u6232\u4E2D\uFF0C\u4F60\u53EF\u4EE5\u5728\u53F3\u908A\u66F8\u5BEB\uFF0C\u4E26\u5B78\u7FD2\u5DE6\u908A\u986F\u793A\u7684\u55AE\u5B57\u7684\u7B46\u756B\u3002(\u60A8\u53EF\u4EE5\u6309\u4E0B\u64AD\u653E\u6309\u9215\u4F86\u5B78\u7FD2\u7B46\u756B\u3002)\r\n\u60A8\u53EF\u4EE5\u4F7F\u7528\u91CD\u8A2D\u6309\u9215\u6E05\u9664\u624B\u5BEB\u677F\u4EE5\u53CA\u4F7F\u7528\u91CD\u64AD\u6309\u9215\u4F86\u56DE\u653E\u4E4B\u524D\u5BEB\u4E0B\u7684\u6587\u5B57\u3002\r\n\u60A8\u4E5F\u53EF\u4EE5\u4F7F\u7528\u624B\u5BEB\u677F\u4E0B\u65B9\u7684\u6ED1\u687F\u4F86\u52A0\u5FEB\u6216\u6E1B\u6162\u5B57\u9AD4\u91CD\u69CB\u904E\u7A0B\u3002"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
