      objectReference: {fileID: 21300000, guid: 53f0e98512c5620488c6b5b960ebc560, type: 3}
    - target: {fileID: 3261846748044018482, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3695404335320377196, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u8A79\u5C0F\u5C0F\u4E5F\u5C0F\u8072\u5730\u8AAA\uFF1A\u300C\u6211\u5C31\u7B97\u8DF3\u8D77\u4F86\uFF0C\u4E5F\u53EA\u6709\u96EA\u689D\u7684\u8173\u8DBE\u982D\u90A3\u9EBC\u9AD8\u3002\u6211\u5011\u662F\u4E0D\u662F\u6C38\u9060\u90FD\u9019\u9EBC\u6E3A\u5C0F\uFF1F\u300D"
      objectReference: {fileID: 0}
    - target: {fileID: 3909810868071495657, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: bc2bcc97199ff9f47ada36c4bfbd4f5a, type: 3}
    - target: {fileID: 4136769696221994347, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: 79bee9aa1b3739b43acc1baf4328c5d3, type: 3}
    - target: {fileID: 4375117376548956419, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u300C\u90A3\u662F\u2026\u2026\u6211\u55CE\uFF1F\u300D\r\n\r\n\u8A79\u5C0F\u5C0F\u767C\u73FE\u81EA\u5DF1\u7684\u5F71\u5B50\u7ADF\u7136\u50CF\u4E00\u5EA7\u9023\u7DBF\u7684\u5C0F\u5C71\uFF0C\u523A\u8B8A\u6210\u4E86\u5DE8\u5927\u7684\u7687\u51A0\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4379363732922247621, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_Sprite
      value: 
      objectReference: {fileID: 21300000, guid: 01649eba0b8647445b38c2d80d8c62cb, type: 3}
    - target: {fileID: 5597225528230718160, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u300C\u5929\u554A\uFF01\u90A3\u662F\u8AB0\uFF1F\u300D\r\n\u963F\u6A59\u5FCD\u4E0D\u4F4F\u9A5A\u53EB\u4E00\u8072\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5604458365603751578, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u592A\u967D\u6F38\u6F38\u897F\u6C89\uFF0C\u96EA\u689D\u63D0\u8B70\uFF1A\u300C\u6211\u5011\u53BB\u5C71\u5761\u4E0A\u770B\u843D\u65E5\u5427\uFF01\u300D\r\n\r\n\u963F\u6A59\u5782\u982D\u55AA\u6C23\u5730\u8D70\u8457\uFF0C\u5B8C\u5168\u6C92\u767C\u73FE\u5730\u9762\u7684\u8B8A\u5316\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5641114696428161770, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u756B\u9762\u51FA\u73FE\u4E86\u4E00\u500B\u5DE8\u5927\u7121\u6BD4\u7684\u9ED1\u5F71\u3002\u5F71\u5B50\u7684\u96D9\u817F\u62C9\u5F97\u8001\u9577\uFF0C\u63EE\u624B\u6642\u5F77\u5F7F\u80FD\u78B0\u5230\u9060\u8655\u7684\u96F2\u6735\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5770454519868337420, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u963F\u6A59\u5FC3\u88E1\u9178\u6E9C\u6E9C\u7684\uFF1A\u300C\u771F\u4E0D\u516C\u5E73\uFF0C\u70BA\u4EC0\u9EBC\u4ED6\u90A3\u9EBC\u9AD8\uFF1F\u300D\u9019\u7A2E\u300C\u6BD4\u8F03\u300D\u7684\u5C0F\u602A\u7378\uFF0C\u5728\u5FC3\u88E1\u6084\u6084\u9577\u5927\u3002"
      objectReference: {fileID: 0}
