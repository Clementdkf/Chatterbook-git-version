    - target: {fileID: 5597225528230718160, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u8A79\u5C0F\u5C0F\u9084\u672A\u4F86\u5F97\u53CA\u56DE\u7B54\uFF0C\u56E0\u70BA\u6BDB\u8863\u592A\u7B28\u91CD\u5931\u53BB\u5E73\u8861\u611F\uFF0C\r\n\u597D\u50CF\u5FEB\u8981\u8DCC\u5012\u4E86\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 5604458365603751578, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u5927\u5BB6\u5728\u8349\u5730\u4E0A\u73A9\u5F97\u597D\u958B\u5FC3\u3002\u963F\u6A59\u5947\u602A\u5730\u554F\uFF1A\u300C\u8A79\u5C0F\u5C0F\uFF0C\u4F60\u4ECA\u5929\u70BA\u4EC0\u9EBC\u52D5\u8D77\u4F86\u602A\u602A\u7684\uFF1F\u300D"
      objectReference: {fileID: 0}
    - target: {fileID: 5641114696428161770, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u8A79\u5C0F\u5C0F\u8DCC\u5728\u5730\u4E0A\u5927\u558A\uFF1A\u300C\u54CE\u5440\uFF01\u597D\u75DB\uFF01\u300D\u982D\u4E5F\u649E\u5012\u4E86\u6905\u5B50\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5770454519868337420, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u70BA\u4E86\u8B8A\u5F97\u300C\u53D7\u6B61\u8FCE\u300D\uFF0C\u4ED6\u7A7F\u4E0A\u4E86\u4E00\u4EF6\u7D62\u9E97\u7684\u5F69\u8272\u6BDB\u8863\u3002\r\n\u4ED6\u5C0D\u8457\u93E1\u5B50\u8F49\u4E86\u4E00\u5708\uFF0C\u6EFF\u610F\u5730\u7B11\u4E86\u3002\r                      
        \u73FE\u5728\u7684\u4ED6\uFF0C\u770B\u8D77\u4F86\u5C31\u50CF\u4E00\u9846\u7E7D\u7D1B\u7684\u5F69\u8679\u7CD6\uFF0C\u5713\u6EFE\u6EFE\u3001\u8EDF\u7DBF\u7DBF\u7684\uFF0C\u5B8C\u5168\u770B\u4E0D\u51FA\u523A\u875F\u7684\u5F71\u5B50\u3002"
