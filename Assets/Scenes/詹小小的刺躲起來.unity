    - target: {fileID: 4375117376548956419, guid: beeba90dc480f5642b8c1ce9a6fd2cc8, type: 3}
      propertyPath: m_text
      value: "\u5C31\u5728\u9019\u6642\uFF0C\u4E00\u96BB\u5927\u9EC3\u8702\u7A81\u7136\u98DB\u904E\u3002\u8A79\u5C0F\u5C0F\u6700\u6015\u6606\u87F2\u4E86\uFF01\u4ED6\u5687\u5F97\u672C\u80FD\u5730\u7E2E\u6210\u4E00\u500B\u7403\u3002"
