      propertyPath: m_text
      value: "\u9019\u5929\uFF0C\u5927\u5BB6\u5728\u8349\u5730\u4E0A\u73A9\u300C\u5927\u98A8\u5439\u300D\u3002\n\n\u8A79\u5C0F\u5C0F\u70BA\u4E86\u4E0D\u8B93\u80CC\u4E0A\u7684\u523A\u523A\u7A7F\u9019\u4EF6\u4EAE\u773C\u7684\u5F69\u8272\u6BDB\u8863\uFF0C\u4ED6\u5FC5\u9808\u633A\u76F4\u80CC\u810A\uFF0C\u975E\u5E38\u8F9B\u82E6\u3002"
